# Local-only runtime configuration. The application constructs its SQLAlchemy URL
# from these separate PostgreSQL fields and writes only to the runtime database below.
POSTGRES_DB=control_tower
POSTGRES_USER=control_tower
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Disposable integration/release gate configuration. This target is deliberately
# separate from the runtime control_tower database. Do not point it at shared or production
# data. TEST_DATABASE_URL is an explicit URL, so URL-encode reserved password
# characters in that one value. The release gate additionally requires
# ALLOW_DESTRUCTIVE_TEST_DB=1.
TEST_DATABASE_URL=postgresql+psycopg://control_tower:replace-with-a-local-password@localhost:5432/control_tower_test

API_BASE_URL=http://127.0.0.1:8000/api/v1
# Set true only for a public deployment; FastAPI rejects lifecycle writes server-side.
PUBLIC_DEMO_READ_ONLY=false
SLA_RISK_WINDOW_HOURS=4
SAFETY_STOCK=20
INVENTORY_MISMATCH_TOLERANCE=5
SEVERITY_CRITICAL_REVENUE_AT_RISK=10000
SEVERITY_HIGH_REVENUE_AT_RISK=5000
SEVERITY_MEDIUM_REVENUE_AT_RISK=1000
SEVERITY_CRITICAL_ORDERS_AFFECTED=50
SEVERITY_HIGH_ORDERS_AFFECTED=20
SEVERITY_MEDIUM_ORDERS_AFFECTED=5
SEVERITY_CRITICAL_OVERDUE_HOURS=48
SEVERITY_HIGH_OVERDUE_HOURS=24
SEVERITY_MEDIUM_OVERDUE_HOURS=4
DETERMINISTIC_SEED=20250301
AS_OF=2025-01-15T12:00:00Z
